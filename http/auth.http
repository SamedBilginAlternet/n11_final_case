@gateway = http://localhost:8080
@token = {{login.response.body.accessToken}}

### Register
POST {{gateway}}/api/auth/register
Content-Type: application/json

{
  "email": "demo@n11.local",
  "password": "demopass123",
  "fullName": "Demo Kullanıcı"
}

### Login
# @name login
POST {{gateway}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@n11.local",
  "password": "demopass123"
}

### Me
GET {{gateway}}/api/users/me
Authorization: Bearer {{token}}

### Refresh — exchange refresh token for new access + rotated refresh
# @name refresh
POST {{gateway}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.refreshToken}}"
}

### Logout — revoke this refresh token
POST {{gateway}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.refreshToken}}"
}
