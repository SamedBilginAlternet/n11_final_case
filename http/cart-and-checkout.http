@gateway = http://localhost:8080
@token = {{login.response.body.accessToken}}

### 0. Login first
# @name login
POST {{gateway}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@n11.local",
  "password": "demopass123"
}

### 1. Get cart (auto-creates empty)
GET {{gateway}}/api/cart
Authorization: Bearer {{token}}

### 2. Add item
POST {{gateway}}/api/cart/items
Authorization: Bearer {{token}}
Content-Type: application/json

{ "productId": 1, "quantity": 1 }

### 3. Update quantity (replace itemId with the id from response)
PUT {{gateway}}/api/cart/items/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "quantity": 2 }

### 4. Remove
DELETE {{gateway}}/api/cart/items/1
Authorization: Bearer {{token}}

### 5. Checkout — triggers OrderCreated saga
POST {{gateway}}/api/orders/checkout
Authorization: Bearer {{token}}

### 6. Poll my orders (status moves PENDING → AWAITING_PAYMENT → CONFIRMED/CANCELLED)
GET {{gateway}}/api/orders
Authorization: Bearer {{token}}
