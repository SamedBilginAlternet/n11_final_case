# Default to native line endings, let git decide for typical text files.
* text=auto

# Force LF for anything that runs / is parsed inside a Linux container.
# Windows checkouts otherwise CRLF these and break shebangs / heredocs.
*.sh         text eol=lf
*.bash       text eol=lf
Dockerfile   text eol=lf
*.dockerfile text eol=lf

# Compose, k8s, CI configs all parsed by Linux tooling — keep LF.
*.yml        text eol=lf
*.yaml       text eol=lf

# SQL migrations executed by Postgres in a Linux container.
*.sql        text eol=lf

# Caddy / nginx configs.
Caddyfile    text eol=lf
*.conf       text eol=lf

# Treat known binaries as binary so git never touches them.
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.pdf        binary
*.jar        binary
*.zip        binary
