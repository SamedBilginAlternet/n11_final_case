# Postgres
POSTGRES_USER=n11
POSTGRES_PASSWORD=n11pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Redis (cache for product-service + cart-service)
REDIS_HOST=redis
REDIS_PORT=6379

# Cache schema version — every cache key is prefixed `<service>:v<N>:<cache>::<key>`.
# Bump this when a deploy changes the cached value shape (DTO field added/removed,
# Redis serializer rewired) — old entries orphan and TTL-evict, no FLUSHALL needed.
# Most deploys leave this alone.  See docs/caching.md.
CACHE_SCHEMA_VERSION=1

# JWT
JWT_SECRET=changeme-32-byte-min-secret-changeme-please-rotate
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=14

# Iyzico (sandbox by default)
IYZICO_API_KEY=sandbox-xxxxxxxx
IYZICO_SECRET_KEY=sandbox-xxxxxxxx
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Slack — only used by GitHub Actions deploy.yml for deploy notifications
# (no runtime service pings Slack). Leave empty in .env to silence local CI.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Chatbot — pick a provider:
#   MOCK   = no external calls (default, dev-friendly)
#   GROQ   = free OpenAI-compatible Groq API (https://console.groq.com)
#   CLAUDE = Anthropic Claude API
CHATBOT_PROVIDER=GROQ

# Groq (free tier — sign up at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Frontend
VITE_API_BASE_URL=http://localhost:8080

# Social login (OAuth2). Leave empty to disable.
# Public callback URL to register at the provider:
#   Google : ${PUBLIC_HOST}/api/auth/oauth2/callback/google
# For local docker-compose: PUBLIC_HOST = http://localhost:8080
# For DigitalOcean droplet : PUBLIC_HOST = https://yourdomain.com  (or http://<ip>)
FRONTEND_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notification mail dispatch.
#
# Local docker-compose: defaults to MailHog (no signup, view at http://localhost:8025).
# Override these in production .env to point at Resend / Brevo / SendGrid.
#
# Resend example (https://resend.com — verify send.<your-domain> in dashboard):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USERNAME=resend
#   SMTP_PASSWORD=re_xxxxxxxxxxxxxxxx       # API key as password
#   SMTP_AUTH=true
#   SMTP_STARTTLS=true
#   MAIL_FROM_ADDRESS=no-reply@send.samedbilgin.com
#   MAIL_FROM_NAME=n11 Sipariş
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM_ADDRESS=no-reply@n11.local
MAIL_FROM_NAME=n11 Sipariş
STOREFRONT_URL=http://localhost:3000
ADMIN_PANEL_URL=http://localhost:3001

# Low-stock alerts (product-service @Scheduled scanner → notification-service)
# Disabled by default; flip ENABLED=true and set ADMIN_ALERT_RECIPIENT to test.
# Cron format: Spring 6-field (sec min hour day month weekday).  Default = 09:00 UTC daily.
# Demo cadence: "0 */5 * * * *" runs every 5 minutes.
LOW_STOCK_ALERTS_ENABLED=false
LOW_STOCK_THRESHOLD=5
LOW_STOCK_CRON=0 0 9 * * *
ADMIN_ALERT_RECIPIENT=
