# Postgres
POSTGRES_USER=n11
POSTGRES_PASSWORD=n11pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT
JWT_SECRET=changeme-32-byte-min-secret-changeme-please-rotate
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=14

# Iyzico (sandbox by default)
IYZICO_API_KEY=sandbox-xxxxxxxx
IYZICO_SECRET_KEY=sandbox-xxxxxxxx
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Slack — only used by GitHub Actions deploy.yml for deploy notifications
# (no runtime service pings Slack). Leave empty in .env to silence local CI.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Chatbot — pick a provider:
#   MOCK   = no external calls (default, dev-friendly)
#   GROQ   = free OpenAI-compatible Groq API (https://console.groq.com)
#   CLAUDE = Anthropic Claude API
CHATBOT_PROVIDER=GROQ

# Groq (free tier — sign up at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Frontend
VITE_API_BASE_URL=http://localhost:8080

# Social login (OAuth2). Leave empty to disable a provider.
# Public callback URLs to register at the provider:
#   Google : ${PUBLIC_HOST}/api/auth/oauth2/callback/google
#   GitHub : ${PUBLIC_HOST}/api/auth/oauth2/callback/github
# For local docker-compose: PUBLIC_HOST = http://localhost:8080
# For DigitalOcean droplet : PUBLIC_HOST = https://yourdomain.com  (or http://<ip>)
FRONTEND_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
