# Reference list of every env var the prod compose file expects.  In the
# actual deployment, /opt/n11/.env is generated by sync-env.sh pulling from
# Infisical (project `n11`, env `prod`).  Edit secrets there, not here —
# this file is just a checklist for what needs to exist in Infisical.
#
# Bootstrap-only vars that DON'T live in Infisical (only on the droplet):
#   /opt/n11/.infisical-auth — INFISICAL_CLIENT_ID/_SECRET/_PROJECT_ID

# GHCR — needed for `docker compose pull`
GHCR_OWNER=samedbilginalternet
GHCR_TOKEN=ghp_...                     # Personal access token with read:packages
IMAGE_TAG=latest

# Public hostname (set to your domain for TLS, leave :80 for plain HTTP)
DOMAIN=:80

# Postgres
POSTGRES_USER=n11
POSTGRES_PASSWORD=change-me-please

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT (>= 32 bytes)
JWT_SECRET=change-me-32-byte-min-secret-please-rotate

# Iyzico
IYZICO_ENABLED=false
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Chatbot
CHATBOT_PROVIDER=GROQ
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=

# SMTP (Resend)
# DO blokladığı için 587 yerine 2587 kullan. MAIL_FROM_ADDRESS Resend'de
# verify edilmiş apex domain olmalı (ör. no-reply@samedbilgin.com — alt domain DEĞİL).
SMTP_HOST=smtp.resend.com
SMTP_PORT=2587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxx
MAIL_FROM_ADDRESS=no-reply@samedbilgin.com
MAIL_FROM_NAME=n11 Sipariş
ADMIN_ALERT_RECIPIENT=

# Public URLs — mail içindeki linkler bu host'a yönlenir.
# Boş bırakırsan notification-service localhost:3000'a fallback eder ve
# müşteriye giden mail bozuk link içerir.
STOREFRONT_URL=https://n11proje.samedbilgin.com
# Admin panel path-prefix kuruldu (https://<storefront>/admin) çünkü
# DNS panelimiz 4-label subdomain'i (admin.n11proje.samedbilgin.com)
# kabul etmedi.  Vite base=/admin/ + Caddy handle_path /admin/* ile
# çalışıyor — detay docs/services/frontend-admin.md.
ADMIN_PANEL_URL=https://n11proje.samedbilgin.com/admin

# Firebase phone auth — service account JSON pasted as a single multi-line
# value into Infisical.  Auth-service uses it to verify Firebase ID tokens
# minted during the SMS OTP flow.  Blank = phone login endpoint returns 401.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Jaeger UI public exposure (basic_auth korumalı).  Boş bırakırsan UI
# sadece docker network'ten erişilebilir kalır (port 16686 expose edilmez).
# Hash üretmek için:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'parolan'
JAEGER_DOMAIN=jaeger.n11proje.samedbilgin.com
JAEGER_USER=admin
JAEGER_PASSWORD_HASH=

# MinIO + S3-compatible object storage.  MINIO_ROOT_* container'ı boot
# eder, S3_ACCESS_KEY/SECRET_KEY product-service'in scoped service-account
# uploader credential'ı (bootstrap-minio.sh çıktısı).  Detay: docs/storage.md.
# CDN_DOMAIN public read endpoint, MINIO_DOMAIN admin console (Caddy
# basic_auth ile koru).  S3_PUBLIC_BASE_URL frontend'e dönen image URL
# prefix'i — boş bırakırsan ProductImageService SDK endpoint'i fallback
# olarak basar (browser'dan ulaşılamaz, dev için).
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-32-byte-min-rotate
MINIO_CONSOLE_USER=admin
MINIO_CONSOLE_PASSWORD_HASH=
CDN_DOMAIN=cdn.n11proje.samedbilgin.com
MINIO_DOMAIN=minio.n11proje.samedbilgin.com
MINIO_CONSOLE_URL=https://minio.n11proje.samedbilgin.com

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=n11-products
S3_PUBLIC_BASE_URL=https://cdn.n11proje.samedbilgin.com/n11-products

# Sentry error tracking — backend için tek DSN tüm 7 servisin event'lerini
# aynı projeye yollar; service tag'ı (service:auth-service vb.) servisler
# arası ayrım sağlar.  Boş DSN ile SDK no-op olur.  Release: Compose
# IMAGE_TAG'ından geliyor, Sentry "Releases" sekmesinde her deploy ayrı
# grup olarak görünür.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Frontend Sentry — ayrı bir Browser/React projesi olarak kuruldu.
# Aşağıdakiler GitHub Actions repo secrets'a yazılmalı (build-time'da
# bundle'a girer ya da source map upload için kullanılır), Infisical'a
# DEĞİL.  VITE_SENTRY_DSN, SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT.
