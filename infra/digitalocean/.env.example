# Drop this file at /opt/n11/.env on the droplet (chmod 600).

# GHCR — needed for `docker compose pull`
GHCR_OWNER=samedbilginalternet
GHCR_TOKEN=ghp_...                     # Personal access token with read:packages
IMAGE_TAG=latest

# Public hostname (set to your domain for TLS, leave :80 for plain HTTP)
DOMAIN=:80

# Postgres
POSTGRES_USER=n11
POSTGRES_PASSWORD=change-me-please

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT (>= 32 bytes)
JWT_SECRET=change-me-32-byte-min-secret-please-rotate

# Iyzico
IYZICO_ENABLED=false
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Slack — used by notification-service for OrderConfirmed/etc
SLACK_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Chatbot
CHATBOT_PROVIDER=GROQ
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
